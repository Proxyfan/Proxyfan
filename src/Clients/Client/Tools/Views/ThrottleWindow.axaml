<Window x:Class="Proxyfan.Client.Tools.Views.ThrottleWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:Proxyfan.Presentation.Localization;assembly=Presentation"
        xmlns:presentation="clr-namespace:Proxyfan.Presentation;assembly=Presentation"
        xmlns:viewModels="clr-namespace:Proxyfan.Client.Tools.ViewModels"
        xmlns:views="clr-namespace:Proxyfan.Client.Tools.Views"
        Title="{localization:Localize Key=Tools_Throttle_Title}"
        Width="420"
        Height="380"
        d:DataContext="{d:DesignInstance Type=viewModels:ThrottleViewModel}"
        presentation:ViewModelLocator.DataContext="{x:Type viewModels:ThrottleViewModel}"
        x:DataType="viewModels:ThrottleViewModel"
        mc:Ignorable="d">
    <views:ThrottleView />
</Window>
