<UserControl x:Class="Proxyfan.Client.Tools.Views.ScriptingView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="clr-namespace:Proxyfan.Presentation.Localization;assembly=Presentation"
             xmlns:presentation="clr-namespace:Proxyfan.Presentation;assembly=Presentation"
             xmlns:viewModels="clr-namespace:Proxyfan.Client.Tools.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ScriptingViewModel}"
             presentation:ViewModelLocator.DataContext="{x:Type viewModels:ScriptingViewModel}"
             x:DataType="viewModels:ScriptingViewModel"
             mc:Ignorable="d">
    <Grid Margin="8" RowDefinitions="Auto,Auto,*,*,Auto,Auto">
        <CheckBox Grid.Row="0"
                  Content="{localization:Localize Key=Tools_Scripting_Enabled}"
                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                  Margin="0,0,0,8" />
        <TextBlock Grid.Row="1"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"
                   Text="{localization:Localize Key=Tools_Scripting_RequestPhase}" />
        <TextBox AutomationProperties.Name="{localization:Localize Key=Tools_Scripting_RequestBox_Automation}"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                 Margin="0,0,0,8"
                 MinHeight="120"
                 Text="{Binding RequestSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="NoWrap"
                 Watermark="{localization:Localize Key=Tools_Scripting_RequestPlaceholder}" />
        <Grid Grid.Row="3" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"
                       Text="{localization:Localize Key=Tools_Scripting_ResponsePhase}" />
            <TextBox AutomationProperties.Name="{localization:Localize Key=Tools_Scripting_ResponseBox_Automation}"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                     Margin="0,0,0,8"
                     MinHeight="120"
                     Text="{Binding ResponseSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="NoWrap"
                     Watermark="{localization:Localize Key=Tools_Scripting_ResponsePlaceholder}" />
        </Grid>
        <StackPanel Grid.Row="4"
                    Margin="0,0,0,8"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Command="{Binding CompileCommand}"
                    Content="{localization:Localize Key=Tools_Scripting_Compile}"
                    Padding="12,4" />
            <Button Command="{Binding ClearScriptCommand}"
                    Content="{localization:Localize Key=Tools_Scripting_Clear}"
                    Padding="12,4" />
            <TextBlock Text="{Binding CompilationStatus}"
                       VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Row="5"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                MaxHeight="160">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Diagnostics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ScriptDiagnosticViewModel">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="4,2">
                                <TextBlock Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           Text="{Binding Severity}"
                                           Width="64" />
                                <TextBlock Grid.Column="1"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Margin="0,0,8,0"
                                           Text="{Binding Location}"
                                           Width="72" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
