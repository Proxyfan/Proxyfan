<Window x:Class="Proxyfan.Client.Tools.Views.ComposerWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:Proxyfan.Presentation.Localization;assembly=Presentation"
        xmlns:presentation="clr-namespace:Proxyfan.Presentation;assembly=Presentation"
        xmlns:viewModels="clr-namespace:Proxyfan.Client.Tools.ViewModels"
        xmlns:views="clr-namespace:Proxyfan.Client.Tools.Views"
        Title="{localization:Localize Key=Tools_Composer_Title}"
        Width="1000"
        Height="720"
        d:DataContext="{d:DesignInstance Type=viewModels:ComposerViewModel}"
        presentation:ViewModelLocator.DataContext="{x:Type viewModels:ComposerViewModel}"
        x:DataType="viewModels:ComposerViewModel"
        mc:Ignorable="d">
    <views:ComposerView />
</Window>
