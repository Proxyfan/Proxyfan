<UserControl x:Class="Proxyfan.Client.Shell.Views.ShellView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inspectorViews="clr-namespace:Proxyfan.Client.Inspector.Views"
             xmlns:localization="clr-namespace:Proxyfan.Presentation.Localization;assembly=Presentation"
             xmlns:presentation="clr-namespace:Proxyfan.Presentation;assembly=Presentation"
             xmlns:trafficViews="clr-namespace:Proxyfan.Client.Traffic.Views"
             xmlns:viewModels="clr-namespace:Proxyfan.Client.Shell.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ShellViewModel}"
             presentation:ViewModelLocator.DataContext="{x:Type viewModels:ShellViewModel}"
             x:DataType="viewModels:ShellViewModel"
             mc:Ignorable="d">
    <Grid RowDefinitions="32,*,24">
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           HorizontalAlignment="Left"
                           Margin="8,0"
                           Text="{localization:Localize Key=Shell_Toolbar_AppName}"
                           VerticalAlignment="Center" />
                <Button Command="{Binding ToggleSystemProxyCommand}"
                        DockPanel.Dock="Right"
                        IsVisible="{Binding IsSystemProxyEnabled}"
                        Margin="4,2"
                        Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="{localization:Localize Key=Shell_Toolbar_DisableProxy}" />
                </Button>
                <Button Command="{Binding ToggleSystemProxyCommand}"
                        DockPanel.Dock="Right"
                        IsVisible="{Binding !IsSystemProxyEnabled}"
                        Margin="4,2"
                        Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="{localization:Localize Key=Shell_Toolbar_EnableProxy}" />
                </Button>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="180,4,*,4,320">
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,1,0">
                <TextBlock HorizontalAlignment="Center"
                           Text="{localization:Localize Key=Shell_SourcePanel_Header}"
                           VerticalAlignment="Center" />
            </Border>
            <GridSplitter Grid.Column="1"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Width="4" />
            <trafficViews:TrafficListView Grid.Column="2" />
            <GridSplitter Grid.Column="3"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Width="4" />
            <inspectorViews:InspectorView Grid.Column="4" />
        </Grid>
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock HorizontalAlignment="Left"
                       Margin="8,0"
                       Text="{localization:Localize Key=Shell_StatusBar_Ready}"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>